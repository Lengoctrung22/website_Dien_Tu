NEXT_PUBLIC_API_URL=http://localhost:5000/api
# OAuth 2.0 Client ID (Web application) from Google Cloud Console, e.g. 1234-abc.apps.googleusercontent.com
# Must match backend GOOGLE_CLIENT_ID. Leave empty to hide the Google button.
# NEXT_PUBLIC_* values are inlined at build time: rebuild/restart Next.js after changing it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
