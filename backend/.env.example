PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/website_dien_tu
JWT_SECRET=techgear_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# OAuth 2.0 Client ID (Web application) from Google Cloud Console, e.g. 1234-abc.apps.googleusercontent.com
